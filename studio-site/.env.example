# Copy this file to .env and fill in real values for local `vercel dev`.
# In production, set these under Vercel → Project → Settings → Environment
# Variables instead (KV_REST_API_URL / KV_REST_API_TOKEN are auto-injected
# when you connect the Redis integration — see api/README.md — so you won't
# need to set those two by hand. The R2_* vars below have no Vercel
# integration and must be set by hand, in both places.)

# --- Contact form (Resend) ---
# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=emrashotit@gmail.com
# Must be an address on a domain you've verified in Resend (resend.com/domains) —
# a Gmail address won't work here even though it's fine for CONTACT_TO_EMAIL above.
# Placeholder below assumes you register a domain; swap for whatever you actually own.
CONTACT_FROM_EMAIL="Emrashotit Studios <noreply@emrashotitstudios.com>"

# --- Client gallery auth ---
# Any long random string — generate with: openssl rand -hex 32
GALLERY_JWT_SECRET=

# --- Admin panel ---
# Any long random string, DIFFERENT from GALLERY_JWT_SECRET above.
ADMIN_JWT_SECRET=
# bcrypt hash of your admin password — generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Paste the resulting $2b$... hash here, never the plain password.
ADMIN_PASSWORD_HASH=

# --- Structured data (auto-injected once connected in the Vercel
#     dashboard — Storage tab → Create Database → Redis) ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- File storage (Cloudflare R2) — create a bucket + API token at
#     dash.cloudflare.com → R2, then enable public access (or a custom
#     domain) on the bucket so R2_PUBLIC_BASE_URL is reachable. See
#     api/README.md for the full setup. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
